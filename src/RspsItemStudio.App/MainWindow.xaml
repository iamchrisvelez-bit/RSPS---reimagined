<Window x:Class="RspsItemStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RspsItemStudio.App.Views"
        Title="RSPS Item Studio"
        Height="720"
        Width="1180"
        MinHeight="480"
        MinWidth="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New project..." Command="{Binding NewProjectCommand}" />
                <MenuItem Header="_Open project..." Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="_Save project" Command="{Binding SaveProjectCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="900" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F4F4F5"
                    BorderBrush="#E4E4E7"
                    BorderThickness="0,0,1,0"
                    Padding="8">
                <StackPanel Width="120">
                    <TextBlock Text="Tools" FontWeight="SemiBold" Margin="4,0,4,8" />
                    <Button Content="Import OBJ" Margin="0,0,0,6" Command="{Binding ImportObjCommand}" />
                    <Button Content="Validate" Margin="0,0,0,6" Command="{Binding ValidateCommand}" />
                    <Button Content="Export staging" Command="{Binding ExportStagingCommand}" />
                </StackPanel>
            </Border>

            <views:ViewportHost Grid.Column="1"
                                Margin="8"
                                DataContext="{Binding Viewport}" />

            <TabControl Grid.Column="2" Margin="0,8,8,8">
                <TabItem Header="Stats">
                    <views:StatEditorView DataContext="{Binding Definition}" />
                </TabItem>
                <TabItem Header="Validation">
                    <views:ValidationReportView DataContext="{Binding Validation}" />
                </TabItem>
                <TabItem Header="Project">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <TextBlock Text="{Binding ProjectSummary}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
